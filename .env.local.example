# Supabase — Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="NewSpace Africa <registration@yourdomain.com>"

# Optional: appended as ?secret=... on the Jotform webhook URL to prevent
# random POSTs from creating fake attendees. Leave unset to disable.
JOTFORM_WEBHOOK_SECRET=change-me-too

# Optional: send email through SMTP instead of Resend (e.g. a Google
# Workspace account, which needs no DNS changes). When SMTP_HOST is set it
# is used; otherwise Resend. For Google, SMTP_PASS is an App Password from
# myaccount.google.com/apppasswords and EMAIL_FROM must be that account.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=registration@yourdomain.com
# SMTP_PASS=xxxx xxxx xxxx xxxx

# --- Registration form (the home page, /) ---

# Stripe — dashboard.stripe.com/apikeys (use sk_test_... until launch)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Stripe -> Developers -> Webhooks -> endpoint https://YOUR-DOMAIN/api/stripe-webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Public address of this app, used for Stripe's return links.
PUBLIC_BASE_URL=https://register.yourdomain.com

# Cloudflare Turnstile (spam protection) — dash.cloudflare.com -> Turnstile.
# Optional: leave both unset to disable (e.g. local development).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to "false" to close public registration (walk-ins still work).
REGISTRATION_OPEN=true

# Optional: override the privacy policy linked from the form.
# (Defaults to this site's own /privacy page.)
# NEXT_PUBLIC_PRIVACY_POLICY_URL=https://spaceinafrica.com/privacy-policy-2/

# Admin sign-in (Supabase Auth). The URL and anon key are public values
# (Supabase -> Project Settings -> API). ADMIN_EMAILS are the owners: always
# super admins, separated by commas.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ADMIN_EMAILS=you@yourdomain.com

# Daily keep-alive job (vercel.json) so the free Supabase project never
# pauses. Any long random string; Vercel sends it with each cron call.
CRON_SECRET=a-long-random-string
